# SIH-059 Antarctic Navigation System — Environment Configuration
# Copy this file to .env for local development

# ==========================================
# Express Backend Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# URL of the Python Flask ML Service
# Local: http://localhost:8000
# Production: https://sih-059-1.onrender.com
ML_SERVICE_URL=http://localhost:8000

# Frontend origin allowed for CORS (e.g. https://dev-trinity-cat.github.io)
FRONTEND_URL=http://localhost:5173

# ==========================================
# React Frontend Configuration (Vite)
# ==========================================
# Base URL for API calls. Leave blank if served from same origin (Express)
# Set when hosted separately (e.g. GitHub Pages):
# VITE_API_URL=https://sih059-app.onrender.com
VITE_API_URL=

# Base URL path for assets (default './' works everywhere)
VITE_BASE_PATH=./

# ==========================================
# Python ML Service Configuration
# ==========================================
# Optional external artifact download URLs if not using local repository files:
# MODEL_URL=
# SPATIAL_MASK_URL=
# LATITUDE_GRID_URL=
# LONGITUDE_GRID_URL=
# NC_URL=
