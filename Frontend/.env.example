# Leave empty when Express serves the UI (same origin /api) or in local dev.
# Set when frontend is hosted separately (e.g. GitHub Pages):
# VITE_API_URL=https://sih059-app.onrender.com
VITE_API_URL=

# Base URL path (default './' works for root and subpath hosting like GitHub Pages):
# VITE_BASE_PATH=/SIH-059/
VITE_BASE_PATH=./

